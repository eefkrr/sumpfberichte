# Verhindere Directory Listings
Options -Indexes

RewriteEngine On

# Direkten Web-Zugriff auf interne PHP-Skripte, Konfiguration, Logs und Dotfiles blockieren
RewriteRule ^logs/ - [F,L]
RewriteRule ^feeds\.config\.json$ - [F,L]
RewriteRule ^fetchFeedsWithProxy\.php$ - [F,L]
RewriteRule (^|/)\. - [F,L]

# Blockiere Zugriffe auf alle (auch nicht existierende) PHP-Dateien
RewriteRule \.php$ - [F,L]

# Schutz der .htaccess-Datei (Apache 2.4 & 2.2)
<Files .htaccess>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Suchmaschinen & Security-Header
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Feed-JSONs immer revalidieren (ETag / Last-Modified), statt blind zu cachen
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Statische Assets cachen
    <FilesMatch "\.(css|js|svg|ico|png)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# GZIP-Kompression für schnellen Abruf der Feed-JSONs und Assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
